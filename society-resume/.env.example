# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/trackly"

# JWT secret for signing tokens
JWT_SECRET="your-secret-key-here"

# Server port
PORT=5000

# AI Provider Selection: "groq" (Cloud LPU) or "local" (Ollama / vLLM Air-Gapped)
AI_PROVIDER="groq"

# Groq Cloud Configuration (used when AI_PROVIDER="groq")
GROQ_API_KEY="gsk_your_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"

# Local / On-Premise Air-Gapped Configuration (used when AI_PROVIDER="local")
OLLAMA_BASE_URL="http://localhost:11434/v1"
LOCAL_TEXT_MODEL="qwen2.5-coder:7b"
LOCAL_VISION_MODEL="llama3.2-vision:11b"

# Resend API key (for email notifications — get one at https://resend.com)
RESEND_API_KEY="re_your_key_here"

# Frontend URL (for CORS — default: http://localhost:5173)
FRONTEND_URL="http://localhost:5173"
